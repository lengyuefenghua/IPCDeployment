<?xml version="1.0" encoding="utf-8"?>
<Deployment schemaVersion="2.0" mode="execute">
  <Meta name="IPCDeployment 只读验证" description="真实执行配置：只运行只读的 CMD、PowerShell 和示例命令，不安装、不写注册表、不改系统设置。" />
  <Options>
    <LogDirectory>logs</LogDirectory>
  </Options>
  <Groups>
    <Group key="environment" name="环境检查">
      <Task key="powershell-check" name="PowerShell 检查">
        <Command id="powershell-check" name="运行 PowerShell 示例" file="commands/sample.ps1" timeoutMinutes="5" successExitCodes="0" />
      </Task>
      <Task key="wait-environment" name="观察等待">
        <Delay id="wait-environment" name="等待 1 秒" seconds="1" />
      </Task>
    </Group>
    <Group key="verification" name="运行验证">
      <Task key="cmd-check" name="CMD 验证">
        <Command id="cmd-check" name="运行 CMD 示例" file="commands/sample.cmd" timeoutMinutes="5" successExitCodes="0" />
      </Task>
      <Task key="inline-powershell" name="内嵌 PowerShell">
        <Command id="inline-powershell" name="运行内嵌 PowerShell" language="powershell" timeoutMinutes="5" successExitCodes="0">
          <Code><![CDATA[
            Write-Output "IPCDeployment inline PowerShell"
            Write-Output ("Time: " + (Get-Date).ToString("s"))
          ]]></Code>
        </Command>
      </Task>
      <Task key="wait-verification" name="验证后等待">
        <Delay id="wait-verification" name="等待 1 秒" seconds="1" />
      </Task>
    </Group>
    <Group key="closing" name="收尾检查">
      <Task key="inline-cmd" name="内嵌 CMD">
        <Command id="inline-cmd" name="运行内嵌 CMD" language="cmd" timeoutMinutes="5" successExitCodes="0">
          <Code><![CDATA[
            @echo off
            echo IPCDeployment inline CMD
            echo Current directory: %CD%
          ]]></Code>
        </Command>
      </Task>
      <Task key="wait-closing" name="收尾等待">
        <Delay id="wait-closing" name="等待 1 秒" seconds="1" />
      </Task>
    </Group>
    <Group key="final" name="完成确认">
      <Task key="run-final" name="最终检查">
        <Command id="run-final" name="运行最终脚本" file="commands/sample.ps1" timeoutMinutes="5" successExitCodes="0" />
      </Task>
      <Task key="wait-final" name="最终等待">
        <Delay id="wait-final" name="等待 1 秒" seconds="1" />
      </Task>
    </Group>
  </Groups>
</Deployment>
