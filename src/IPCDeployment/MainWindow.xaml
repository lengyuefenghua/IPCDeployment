<ui:FluentWindow x:Class="IPCDeployment.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="工控机部署工具"
                 Width="1180"
                 Height="840"
                 MinWidth="1040"
                 MinHeight="760"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="SurfaceCard" TargetType="{x:Type ui:Card}">
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#8492A5" />
    </Style>
    <Style x:Key="CardHeading" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#172033" />
    </Style>
    <Style x:Key="BodyCopy" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#637189" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <DataTemplate x:Key="RailGroupTemplate">
      <Grid Margin="0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="16" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#172033" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
        <ui:TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="10" Foreground="#8492A5" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OverviewGroupTemplate">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#172033" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" Text="{Binding TaskSummaryText}" FontSize="11" Foreground="#637189" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TaskRowTemplate">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="16" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <ui:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#172033" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#8492A5" />
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
          <ui:TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#54657E" HorizontalAlignment="Right" />
          <ui:TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CompletionStepTemplate">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="13" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="6,0,8,0">
          <ui:TextBlock Text="{Binding Name}" FontSize="12" Foreground="#354258" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8492A5" TextWrapping="Wrap" />
        </StackPanel>
        <ui:TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" Margin="0,0,8,0" />
        <ui:TextBlock Grid.Column="3" Text="{Binding ElapsedText}" FontSize="11" Foreground="#8492A5" MinWidth="48" TextAlignment="Right" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CompletionTaskTemplate">
      <StackPanel Margin="0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="16" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <ui:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#172033" TextTrimming="CharacterEllipsis" />
            <ui:TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <ui:TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#54657E" HorizontalAlignment="Right" />
            <ui:TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="#8492A5" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
        <ui:ListView ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource CompletionStepTemplate}"
                     BorderThickness="0" Background="Transparent" Margin="24,2,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LogLineTemplate">
      <ui:TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#354258" TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="CompletionGroupTemplate">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="16" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <ui:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#172033" />
          <ui:TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#8492A5" />
        </StackPanel>
        <ui:TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="12" Foreground="#54657E" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OperationRowTemplate">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="16" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Margin="8,0,12,0">
          <ui:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#172033" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <ui:TextBlock Text="{Binding TypeText}" Foreground="#54657E" FontSize="10" Margin="0,0,8,0" />
            <ui:TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8492A5" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            <ui:TextBlock Text="{Binding RestartText}" FontSize="11" Foreground="#B45309" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
          <ui:TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" HorizontalAlignment="Right" />
          <ui:TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="#8492A5" HorizontalAlignment="Right" Margin="0,3,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid Background="#F6F8FC">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
      <RowDefinition Height="58" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="工控机部署工具" Background="#F6F8FC" Foreground="#172033">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/logo.ico" Width="16" Height="16" Margin="0,0,8,0" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="262" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="#FBFCFE">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:ListView Grid.Row="0" Grid.RowSpan="3" x:Name="NavigationList" ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                     ItemTemplate="{StaticResource RailGroupTemplate}" Margin="18,18,18,20" />
      </Grid>

      <Grid Grid.Column="1" Margin="34,24,34,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="210" />
        </Grid.RowDefinitions>

        <Grid ClipToBounds="True" Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <ui:TextBlock Text="任务总览" FontSize="27" FontWeight="SemiBold" Foreground="#172033" />
            <ui:TextBlock Text="{Binding SummaryText}" Style="{StaticResource BodyCopy}" Margin="0,6,0,0" />
          </StackPanel>

          <ui:InfoBar Grid.Row="1" Margin="0,14,0,0" Message="{Binding ModeDetail}"
                      Severity="Informational" IsOpen="True" IsClosable="False" />

          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Style="{StaticResource SurfaceCard}" Margin="0,0,10,0">
              <StackPanel>
                <ui:TextBlock Text="分组" Style="{StaticResource CardHeading}" />
                <ui:TextBlock Text="{Binding GroupCountText}" FontSize="20" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,7,0,0" />
              </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="5,0">
              <StackPanel>
                <ui:TextBlock Text="任务" Style="{StaticResource CardHeading}" />
                <ui:TextBlock Text="{Binding TaskCountText}" FontSize="20" FontWeight="SemiBold" Foreground="#172033" Margin="0,7,0,0" />
              </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="2" Style="{StaticResource SurfaceCard}" Margin="10,0,0,0">
              <StackPanel>
                <ui:TextBlock Text="步骤" Style="{StaticResource CardHeading}" />
                <ui:TextBlock Text="{Binding StepCountText}" FontSize="20" FontWeight="SemiBold" Foreground="#172033" Margin="0,7,0,0" />
              </StackPanel>
            </ui:Card>
          </Grid>

          <ui:Card Grid.Row="3" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
            <StackPanel>
              <ui:TextBlock Text="配置文件" Style="{StaticResource CardHeading}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ConfigFiles}"
                          SelectedItem="{Binding SelectedConfigFile, Mode=TwoWay}"
                          IsEnabled="{Binding CanReload}"
                          DropDownOpened="ConfigCombo_DropDownOpened"
                          VerticalContentAlignment="Center" />
                <ui:Button Grid.Column="1" Content="编辑配置" Appearance="Secondary" Click="EditConfigButton_Click" Margin="10,0,0,0" Padding="12,7" IsEnabled="{Binding CanReload}" />
                <ui:Button Grid.Column="2" Content="校验配置" Appearance="Secondary" Click="ValidateConfigButton_Click" Margin="10,0,0,0" Padding="12,7" IsEnabled="{Binding CanReload}" />
                <ui:Button Grid.Column="3" Content="开始部署  →" Appearance="Primary" Click="StartButton_Click" Margin="10,0,0,0" Padding="14,7" IsEnabled="{Binding CanStartNow}" />
              </Grid>
              <ui:TextBlock Text="{Binding ConfigPathText}" FontSize="12" Foreground="#64748B" Margin="0,8,0,0" />
            </StackPanel>
          </ui:Card>

          <ui:Card Grid.Row="4" Style="{StaticResource SurfaceCard}" Margin="0,12,0,0"
                   Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <ui:TextBlock Text="校验问题" Style="{StaticResource CardHeading}" />
              <ui:TextBox Text="{Binding ValidationText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                          TextWrapping="Wrap" MinHeight="60" MaxHeight="110" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </ui:Card>

          <ui:Card Grid.Row="5" Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ui:TextBlock Text="任务概况" Style="{StaticResource CardHeading}" />
              <ui:TextBlock Grid.Row="1" Text="按分组预览将要执行的任务和步骤。" Style="{StaticResource BodyCopy}" Margin="0,4,0,8" />
              <ui:ListView Grid.Row="2" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                           BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource OverviewGroupTemplate}" />
            </Grid>
          </ui:Card>
        </Grid>

        <Grid ClipToBounds="True" Visibility="{Binding ShowGroup, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ui:Card Grid.Row="0" Style="{StaticResource SurfaceCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <ui:TextBlock Text="{Binding SelectedGroup.Name}" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
                  <ui:TextBlock Text="{Binding SelectedGroup.ProgressText}" FontSize="13" Foreground="#2563EB" VerticalAlignment="Bottom" Margin="12,0,0,3" />
                  <ui:TextBlock Text="{Binding SelectedGroup.StatusText}" FontSize="13" Foreground="{Binding SelectedGroup.StatusBrush}"
                                VerticalAlignment="Bottom" Margin="12,0,0,3" />
                </StackPanel>
              </StackPanel>
              <ui:Button Grid.Column="1" Content="停止部署" Appearance="Danger" Click="StopButton_Click"
                         VerticalAlignment="Center" Padding="16,8" IsEnabled="{Binding IsRunning}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </ui:Card>

          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Card Style="{StaticResource SurfaceCard}" Margin="0,0,14,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:TextBlock Text="任务列表" Style="{StaticResource CardHeading}" />
                <ui:ListView Grid.Row="1" ItemsSource="{Binding SelectedGroup.Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource TaskRowTemplate}" Margin="0,8,0,0" />
              </Grid>
            </ui:Card>

            <ui:Card Grid.Column="1" Style="{StaticResource SurfaceCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                  <ui:TextBlock Text="{Binding SelectedTask.ProgressText, StringFormat=选中任务 · {0}}" FontSize="18" FontWeight="SemiBold" Foreground="#172033" />
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <ui:TextBlock Text="{Binding SelectedTask.Name}" FontSize="13" Foreground="#172033" Margin="0,0,12,0" />
                    <ui:TextBlock Text="{Binding SelectedTask.StatusText}" FontSize="12" Foreground="{Binding SelectedTask.StatusBrush}" />
                  </StackPanel>
                </StackPanel>

                <ui:ListView Grid.Row="1" ItemsSource="{Binding SelectedTaskSteps}" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource OperationRowTemplate}" Margin="0,10,0,0" />
              </Grid>
            </ui:Card>
          </Grid>
        </Grid>

        <Grid ClipToBounds="True" Visibility="{Binding ShowReport, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ui:Card Style="{StaticResource SurfaceCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:TextBlock Text="执行结果" FontSize="27" FontWeight="SemiBold" Foreground="#172033" />
                <ui:TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="#2563EB" VerticalAlignment="Bottom" Margin="12,0,0,4" />
              </StackPanel>
            </StackPanel>
          </ui:Card>

          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Style="{StaticResource SurfaceCard}" Margin="0,0,8,0">
              <StackPanel>
                <ui:TextBlock Text="总任务" Style="{StaticResource Eyebrow}" />
                <ui:TextBlock Text="{Binding CurrentReport.TotalTaskCount}" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
              </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="3,0">
              <StackPanel>
                <ui:TextBlock Text="成功任务" Style="{StaticResource Eyebrow}" />
                <ui:TextBlock Text="{Binding CurrentReport.SucceededTaskCount}" FontSize="20" FontWeight="SemiBold" Foreground="#15803D" />
              </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="2" Style="{StaticResource SurfaceCard}" Margin="5,0">
              <StackPanel>
                <ui:TextBlock Text="失败任务" Style="{StaticResource Eyebrow}" />
                <ui:TextBlock Text="{Binding CurrentReport.FailedTaskCount}" FontSize="20" FontWeight="SemiBold" Foreground="#DC2626" />
              </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="3" Style="{StaticResource SurfaceCard}" Margin="8,0,0,0">
              <StackPanel>
                <ui:TextBlock Text="未执行任务" Style="{StaticResource Eyebrow}" />
                <ui:TextBlock Text="{Binding CurrentReport.NotExecutedTaskCount}" FontSize="20" FontWeight="SemiBold" Foreground="#B45309" />
              </StackPanel>
            </ui:Card>
          </Grid>

          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="400" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Style="{StaticResource SurfaceCard}" Margin="0,0,14,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:TextBlock Text="分组结果" Style="{StaticResource CardHeading}" />
                <ui:ListView Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedReportGroup, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource CompletionGroupTemplate}" Margin="0,8,0,0" />
              </Grid>
            </ui:Card>
            <ui:Card Grid.Column="1" Style="{StaticResource SurfaceCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:TextBlock Text="{Binding SelectedReportGroup.Name, StringFormat=任务结果 · {0}}" Style="{StaticResource CardHeading}" />
                <ui:ListView Grid.Row="1" ItemsSource="{Binding CompletionTasks}" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource CompletionTaskTemplate}" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
              </Grid>
            </ui:Card>
          </Grid>
        </Grid>

        <ui:Card Grid.Row="1" Padding="0" Background="#FFFFFF" BorderBrush="#E3E9F2" BorderThickness="1" Margin="0,14,0,0">
          <StackPanel Margin="16">
            <ui:TextBlock Text="运行日志" FontWeight="SemiBold" Foreground="#172033" />
            <ui:TextBlock Text="总览/完成显示全局日志；分组页显示当前任务日志" FontSize="11" Foreground="#637189" Margin="0,4,0,6" />
            <ui:ListView x:Name="LogList" ItemsSource="{Binding PageLogLines}" ItemTemplate="{StaticResource LogLineTemplate}"
                         Background="#FFFFFF" Foreground="#354258" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Height="120" />
          </StackPanel>
        </ui:Card>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Background="White">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBlock Text="{Binding FooterText}" Style="{StaticResource BodyCopy}"
                    Margin="30,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,30,0">
        <ui:Button Content="打开执行日志" Appearance="Secondary" Click="OpenLogButton_Click" Padding="16,8" IsEnabled="{Binding CanOpenLog}" />
        <ui:Button Content="退出" Appearance="Secondary" Click="ExitButton_Click" Margin="10,0,0,0" Padding="16,8" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
