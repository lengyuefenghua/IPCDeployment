<ui:FluentWindow x:Class="IPCDeployment.ConfigurationEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="配置编辑器"
                 Width="1120"
                 Height="760"
                 MinWidth="920"
                 MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="CardHeading" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#172033" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#54657E" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="FieldHint" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8492A5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding Glyph}" FontSize="13" Foreground="#8492A5" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" Foreground="#172033"
                      TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
    </HierarchicalDataTemplate>

    <DataTemplate x:Key="FieldTemplate">
      <StackPanel Margin="0,0,0,12">
        <ui:TextBlock Text="{Binding LabelText}" Style="{StaticResource FieldLabel}" />
        <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="{Binding IsReadOnly}"
                    Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
        <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True" TextWrapping="Wrap" Height="128" FontFamily="Consolas"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ShowMultiline, Converter={StaticResource BoolToVisibility}}" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}"
                     Visibility="{Binding ShowCombo, Converter={StaticResource BoolToVisibility}}" />
        <CheckBox Content="启用" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                     Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVisibility}}" />
        <ui:TextBlock Text="{Binding Hint}" Style="{StaticResource FieldHint}"
                      Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IssueTemplate">
      <ui:TextBlock Text="{Binding Text}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,3" />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid Background="#F6F8FC">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding TitleText}" Background="#F6F8FC" Foreground="#172033" />

    <ui:Card Grid.Row="1" Margin="16,0,16,10" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Content="新建" Appearance="Secondary" Padding="12,6" Click="NewButton_Click" />
        <ui:Button Grid.Column="1" Content="打开…" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                   Click="OpenButton_Click" />
        <ui:Button Grid.Column="2" Content="保存" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                   Click="SaveButton_Click" />
        <ui:Button Grid.Column="3" Content="另存为…" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                   Click="SaveAsButton_Click" />
        <ui:TextBox Grid.Column="4" Text="{Binding FilePathText, Mode=OneWay}" IsReadOnly="True"
                    Margin="12,0" VerticalContentAlignment="Center" />
        <ui:TextBlock Grid.Column="5" Text="• 未保存" FontSize="12" Foreground="#B45309" VerticalAlignment="Center"
                      Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </ui:Card>

    <Grid Grid.Row="2" Margin="16,0,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ui:TextBlock Text="结构" Style="{StaticResource CardHeading}" FontSize="14" Margin="4,2,0,8" />
          <TreeView Grid.Row="1" x:Name="StructureTree" ItemsSource="{Binding Roots}"
                    ItemTemplate="{StaticResource NodeTemplate}" BorderThickness="0" Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItemChanged="StructureTree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
              <Style TargetType="{x:Type TreeViewItem}"
                     BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Padding" Value="2" />
              </Style>
            </TreeView.ItemContainerStyle>
          </TreeView>
        </Grid>
      </ui:Card>

      <ui:Card Grid.Column="1" Margin="10,0,0,0" Padding="16" VerticalAlignment="Stretch"
               VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <ui:TextBlock Text="{Binding SelectedTypeText}" Style="{StaticResource CardHeading}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}"
                          MaxWidth="820" HorizontalAlignment="Stretch" />
          </ScrollViewer>
          <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
        </Grid>
      </ui:Card>
    </Grid>

    <ui:Card Grid.Row="3" Margin="16,0,16,10" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Content="新增分组" Appearance="Secondary" Padding="12,6" Click="AddGroupButton_Click" />
        <ui:Button Grid.Column="1" Content="新增任务" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                   Click="AddTaskButton_Click" IsEnabled="{Binding CanAddTask}" />
        <ComboBox Grid.Column="2" Width="130" Margin="8,0,0,0" ItemsSource="{Binding StepTypes}"
                     SelectedItem="{Binding NewStepType, Mode=TwoWay}" />
        <ui:Button Grid.Column="3" Content="新增步骤" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                   Click="AddStepButton_Click" IsEnabled="{Binding CanAddStep}" />
        <ui:Button Grid.Column="4" Content="删除" Appearance="Danger" Padding="12,6" Margin="8,0,0,0"
                   Click="DeleteButton_Click" IsEnabled="{Binding CanRemove}" />
        <StackPanel Grid.Column="6" Orientation="Horizontal">
          <ui:Button Content="↑" Appearance="Secondary" Padding="12,6" Click="MoveUpButton_Click"
                     IsEnabled="{Binding CanMoveUp}" />
          <ui:Button Content="↓" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Click="MoveDownButton_Click"
                     IsEnabled="{Binding CanMoveDown}" />
          <ui:TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#637189" VerticalAlignment="Center"
                        Margin="14,0,0,0" />
        </StackPanel>
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="4" Margin="16,0,16,16" Padding="12,8"
             Visibility="{Binding ShowIssues, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:InfoBar IsOpen="{Binding ShowIssues}" IsClosable="False" Severity="Error"
                    Title="{Binding IssuesTitle}" Message="点击条目可定位到对应节点。" />
        <ui:ListView Grid.Row="1" MaxHeight="132" ItemsSource="{Binding Issues}" BorderThickness="0"
                     Background="Transparent" ItemTemplate="{StaticResource IssueTemplate}"
                     SelectedItem="{Binding SelectedIssue, Mode=TwoWay}" Margin="0,6,0,0" />
      </Grid>
    </ui:Card>
  </Grid>
</ui:FluentWindow>
