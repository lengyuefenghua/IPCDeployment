<ui:FluentWindow x:Class="IPCDeployment.ConfigurationEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding TitleText}"
                 Width="1280"
                 Height="820"
                 MinWidth="1024"
                 MinHeight="680"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="CardHeading" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#172033" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#3B4A63" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#54657E" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldHint" TargetType="{x:Type ui:TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#B91C1C" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding Glyph}" FontSize="13" Foreground="#8492A5" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="11" Foreground="#8492A5"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      Visibility="{Binding IsStep, Converter={StaticResource BoolToVisibility}}" />
        <ui:TextBlock Grid.Column="2" Text="{Binding SequenceText}" FontSize="11" Foreground="#8492A5"
                      VerticalAlignment="Center" Margin="0,0,6,0" />
        <ui:TextBlock Grid.Column="3" Text="{Binding NameText}" FontSize="13" Foreground="#172033"
                      TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="4" Text="{Binding ChildCountText}" FontSize="11" Foreground="#8492A5"
                      VerticalAlignment="Center" Margin="6,0,0,0" />
        <ui:TextBlock Grid.Column="5" Text="●" FontSize="11" Foreground="#D97706"
                      VerticalAlignment="Center" Margin="6,0,0,0"
                      Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button Grid.Column="6" Content="+" Appearance="Transparent" Padding="8,0" Margin="4,0,0,0"
                   FontSize="13" ToolTip="新增步骤" Tag="{Binding}" Click="AddStepButton_Click"
                   Visibility="{Binding IsTask, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </HierarchicalDataTemplate>

    <DataTemplate x:Key="FieldTemplate">
      <Grid Margin="0,0,0,6"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Grid.Column="0" Text="▌" FontSize="13" Margin="0,6,0,0"
                      VerticalAlignment="Top">
          <ui:TextBlock.Style>
            <Style TargetType="{x:Type ui:TextBlock}">
              <Setter Property="Foreground" Value="#B91C1C" />
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                  <Setter Property="Foreground" Value="#2563EB" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:TextBlock.Style>
        </ui:TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,8,0">
          <ui:TextBlock Text="{Binding LabelText}" Style="{StaticResource FieldLabel}" />
          <ui:TextBlock Text="ⓘ" FontSize="11" Foreground="#8492A5" Margin="4,0,0,0"
                        ToolTip="{Binding Hint}"
                        Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      LostFocus="FieldInput_LostFocus"
                      Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
          <ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                    ItemsSource="{Binding PickerOptions}"
                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="FieldInput_LostFocus"
                    ToolTip="可从 data 下已有条目里选，也可以直接输入"
                    Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVisibility}}" />
          <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      AcceptsReturn="True" TextWrapping="Wrap" Height="200" FontFamily="Consolas"
                      VerticalScrollBarVisibility="Auto"
                      LostFocus="FieldInput_LostFocus"
                      Visibility="{Binding ShowMultiline, Converter={StaticResource BoolToVisibility}}" />
          <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}"
                    LostFocus="FieldInput_LostFocus"
                    Visibility="{Binding ShowCombo, Converter={StaticResource BoolToVisibility}}" />
          <CheckBox Content="启用" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                    LostFocus="FieldInput_LostFocus"
                    Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVisibility}}" />
          <ui:TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldHint}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SectionTemplate">
      <StackPanel Margin="0,0,0,14"
                  Visibility="{Binding HasVisibleFields, Converter={StaticResource BoolToVisibility}}">
        <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Left" Padding="0,2,0,4" Click="SectionHeader_Click">
          <StackPanel Orientation="Horizontal">
            <ui:TextBlock Text="{Binding ToggleGlyph}" FontSize="11" Foreground="#637189"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
            <ui:TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionHeading}" />
          </StackPanel>
        </ui:Button>
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SearchResultTemplate">
      <StackPanel Margin="0,3">
        <StackPanel Orientation="Horizontal">
          <ui:TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#8492A5" Margin="0,0,8,0"
                        VerticalAlignment="Center" />
          <ui:TextBlock Text="{Binding Title}" FontSize="13" Foreground="#172033"
                        TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ui:TextBlock Text="{Binding PathText}" FontSize="11" Foreground="#8492A5"
                      TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IssueTemplate">
      <ui:TextBlock Text="{Binding Text}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,3" />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid Background="#F6F8FC">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding TitleText}" Background="#F6F8FC" Foreground="#172033" />

    <ui:Card Grid.Row="1" Margin="16,0,16,10" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox Grid.Column="0" Width="220" VerticalAlignment="Center"
                  ItemsSource="{Binding ConfigFiles}"
                  SelectedItem="{Binding SelectedConfigFile, Mode=TwoWay}"
                  DropDownOpened="ConfigCombo_DropDownOpened"
                  ToolTip="切换 config 文件夹下的配置（示例文件不列出）" />
        <ui:Button Grid.Column="1" Content="新建" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                   Click="NewButton_Click" />
        <ui:Button Grid.Column="2" Content="保存" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                   Click="SaveButton_Click" />
        <ui:Button Grid.Column="3" Content="另存为…" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                   Click="SaveAsButton_Click" />
        <Grid Grid.Column="4" Margin="14,0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Text="{Binding FilePathText}" FontSize="12" Foreground="#54657E"
                        TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePathText}" />
          <ui:TextBlock Grid.Column="1" Text="{Binding SavedAtText}" FontSize="12" Foreground="#8492A5"
                        Margin="10,0,0,0" />
        </Grid>
        <ui:Badge Grid.Column="5" Content="{Binding ModeBadgeText}" FontSize="12" VerticalAlignment="Center">
          <ui:Badge.Style>
            <Style TargetType="{x:Type ui:Badge}">
              <Setter Property="Appearance" Value="Secondary" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuteMode}" Value="True">
                  <Setter Property="Appearance" Value="Danger" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Badge.Style>
        </ui:Badge>
        <ui:Button Grid.Column="6" Content="{Binding IssueCountText}" Appearance="Secondary" Padding="12,6"
                   Margin="10,0,0,0" Click="IssueButton_Click" IsEnabled="{Binding HasIssues}" />
      </Grid>
    </ui:Card>

    <Grid Grid.Row="2" Margin="16,0,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card Padding="10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="搜索名称 / 键 / 类型…（Esc 清除）" />
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <TreeView x:Name="StructureTree" ItemsSource="{Binding Roots}"
                      ItemTemplate="{StaticResource NodeTemplate}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItemChanged="StructureTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="StructureTree_PreviewMouseRightButtonDown"
                      Visibility="{Binding ShowTree, Converter={StaticResource BoolToVisibility}}">
              <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}"
                       BasedOn="{StaticResource {x:Type TreeViewItem}}">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                  <Setter Property="Padding" Value="2" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="新增分组" Click="AddGroupButton_Click" />
                  <MenuItem Header="新增任务" Click="AddTaskButton_Click" IsEnabled="{Binding CanAddTask}" />
                  <MenuItem Header="新增步骤" IsEnabled="{Binding CanAddStep}"
                            ItemsSource="{Binding StepTypeOptions}">
                    <MenuItem.ItemContainerStyle>
                      <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="Tag" Value="{Binding}" />
                        <EventSetter Event="Click" Handler="AddStepType_Click" />
                      </Style>
                    </MenuItem.ItemContainerStyle>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="上移" Click="MoveUpButton_Click" IsEnabled="{Binding CanMoveUp}" />
                  <MenuItem Header="下移" Click="MoveDownButton_Click" IsEnabled="{Binding CanMoveDown}" />
                  <Separator />
                  <MenuItem Header="删除" Click="DeleteButton_Click" IsEnabled="{Binding CanRemove}" />
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
            <ui:ListView ItemsSource="{Binding SearchResults}"
                         ItemTemplate="{StaticResource SearchResultTemplate}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SearchList_SelectionChanged"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Content="+ 分组" Appearance="Secondary" Padding="10,5" Click="AddGroupButton_Click" />
            <ui:Button Grid.Column="1" Content="+ 任务" Appearance="Secondary" Padding="10,5" Margin="6,0,0,0"
                       Click="AddTaskButton_Click" IsEnabled="{Binding CanAddTask}" />
            <ui:Button Grid.Column="3" Content="↑" Appearance="Secondary" Padding="10,5"
                       ToolTip="上移（Alt+↑）" Click="MoveUpButton_Click" IsEnabled="{Binding CanMoveUp}" />
            <ui:Button Grid.Column="4" Content="↓" Appearance="Secondary" Padding="10,5" Margin="6,0,0,0"
                       ToolTip="下移（Alt+↓）" Click="MoveDownButton_Click" IsEnabled="{Binding CanMoveDown}" />
            <ui:Button Grid.Column="5" Content="删除" Appearance="Danger" Padding="10,5" Margin="6,0,0,0"
                       Click="DeleteButton_Click" IsEnabled="{Binding CanRemove}" />
          </Grid>
        </Grid>
      </ui:Card>

      <ui:Card Grid.Column="1" Margin="10,0,0,0" Padding="16" VerticalAlignment="Stretch"
               VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ui:TextBlock Text="{Binding BreadcrumbText}" FontSize="11" Foreground="#8492A5"
                        TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource CardHeading}"
                          TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ui:Badge Grid.Column="1" Content="{Binding SelectedTypeText}" Appearance="Secondary" FontSize="11"
                      Margin="10,0,0,0" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" Text="● 未保存" FontSize="11" Foreground="#D97706" Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Visibility="{Binding SelectedNode.IsDirty, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock Grid.Column="3" Text="{Binding SelectedNode.IdentityText}" FontFamily="Consolas"
                          FontSize="11" Foreground="#9AA7B8" Margin="16,0,0,0" VerticalAlignment="Center"
                          ToolTip="自动生成，只读" />
          </Grid>
          <ScrollViewer x:Name="FieldScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}"
                            MaxWidth="900" HorizontalAlignment="Stretch" />
              <ui:TextBlock Text="选择左侧节点开始编辑。" FontSize="12" Foreground="#8492A5">
                <ui:TextBlock.Style>
                  <Style TargetType="{x:Type ui:TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasSelection}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:TextBlock.Style>
              </ui:TextBlock>
            </Grid>
          </ScrollViewer>
          <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="3" />
        </Grid>
      </ui:Card>
    </Grid>

    <ui:Card Grid.Row="3" Margin="16,0,16,10" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#54657E" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Foreground="#8492A5"
                      Margin="12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="2" Text="{Binding IssueCountText}" FontSize="12" Foreground="#637189"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
        <ui:TextBlock Grid.Column="3" Text="Ctrl+S 保存 · Ctrl+N 新建 · Alt+↑↓ 移动 · Del 删除 · Ctrl+F 搜索" FontSize="12"
                      Foreground="#8492A5" VerticalAlignment="Center" />
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="4" Margin="16,0,16,16" Padding="12,8"
             Visibility="{Binding ShowIssuePanel, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:InfoBar IsOpen="{Binding ShowIssuePanel}" IsClosable="False" Severity="Error"
                      Title="{Binding IssuesTitle}" Message="点击条目可定位到对应节点。" />
          <ui:Button Grid.Column="1" Content="收起" Appearance="Secondary" Padding="10,5" Margin="8,0,0,0"
                     Click="CloseIssuePanel_Click" />
        </Grid>
        <ui:ListView Grid.Row="1" MaxHeight="150" ItemsSource="{Binding Issues}" BorderThickness="0"
                     Background="Transparent" ItemTemplate="{StaticResource IssueTemplate}"
                     SelectedItem="{Binding SelectedIssue, Mode=TwoWay}" Margin="0,6,0,0" />
      </Grid>
    </ui:Card>
  </Grid>
</ui:FluentWindow>
