<ui:FluentWindow x:Class="IPCDeployment.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="关于"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Background="#F6F8FC">
  <Grid Background="#F6F8FC">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="关于" ShowMinimize="False" ShowMaximize="False"
                 Background="#F6F8FC" Foreground="#172033" />

    <StackPanel Grid.Row="1" Margin="28,12,28,24">
      <StackPanel Orientation="Horizontal">
        <ui:ImageIcon x:Name="AppIcon" Width="48" Height="48" Margin="0,0,16,0" />
        <StackPanel VerticalAlignment="Center">
          <ui:TextBlock Text="工控机部署工具" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
          <ui:TextBlock x:Name="VersionText" FontSize="12" Foreground="#8492A5" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>

      <ui:TextBlock x:Name="InfoText" Margin="0,22,0,0" FontSize="13" LineHeight="26"
                    Foreground="#354258" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
        <ui:Button Content="确定" Appearance="Secondary" Width="88" Height="32"
                   IsDefault="True" Click="OkButton_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
